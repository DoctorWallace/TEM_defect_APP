        p1ClearCurrentExpectedPixelBindingInMemory();
        showStatus("CTL P1 freeze rechazado: " + bindingResult);
        showMessage("Freeze P1 rechazado", bindingResult + "\n\nNo se ha escrito el proyecto ni la fuente.");
        return 0;
    }
    bindingFields = split(bindingResult,"\t");
    if (bindingFields.length != 7 || bindingFields[0] != "OK") {
        p1ClearCurrentExpectedPixelBindingInMemory();
        return 0;
    }
    p1MasterPixelSha256 = toLowerCase(bindingFields[1]);
    p1ExpectedPixelBindingStatus = "BOUND_FROM_INDEPENDENT_FREEZE";
    showStatus("expectedPixel P1 ligado read-only: " + bindingFields[5]);
    return 1;
}


function p1BindAndVerifyExpectedPixelFreezeReadOnly() {
    if (!p1BindExpectedPixelFreezeReadOnly()) return;
    stampOk = p1StampImageContext();
    verifyStatus = "NOT_VERIFIED";
    if (stampOk) verifyStatus = p1VerifyMaster();
    if (!stampOk || verifyStatus != "VERIFIED") {
        showMessage("Master P1 no verificado", "El freeze fue rechazado por la verificacion source/master. No se escribio ningun original.");
        return;
    }
    showMessage("Master P1 verificado", "El source y los pixeles master coinciden con el freeze independiente ligado a image_id + source_sha256.");
}


function p1StampImageContext() {
    if (nImages() <= 0) return 0;
    if (!p1EnsureSessionIdentity()) return 0;
    p1MasterPixelSha256 = "";
    expectedPixel = "";
    masterHashStatus = p1ImageProperty("CTL.P1.master_pixel_hash_status");
    if (masterHashStatus == "VERIFIED") expectedPixel = p1ImageProperty("CTL.P1.master_pixel_sha256");
    if (expectedPixel != "") p1MasterPixelSha256 = toLowerCase(expectedPixel);
    storedGeneration = parseFloat(p1ImageProperty("CTL.P1.generation_token"));
    if (!isNaN(storedGeneration) && storedGeneration >= 1) p1GenerationToken = floor(storedGeneration);
    storedSelection = parseFloat(p1ImageProperty("CTL.P1.selection_revision"));
    if (!isNaN(storedSelection) && storedSelection >= 0) p1SelectionRevision = floor(storedSelection);
    updateScaleMaybe();
    scaleMethod = p1ImageProperty("CTL.P1.scale_method");
    if (scaleMethod == "") scaleMethod = lightScaleOrigin;
    if (scaleMethod == "") scaleMethod = "NOT_VERIFIED";
    code = "(function(){var imp=Packages.ij.WindowManager.getCurrentImage();if(imp==null)return 'NO_IMAGE';";
    code = code + "function put(k,v){imp.setProperty(k,String(v));}";
    code = code + "put('CTL.P1.project_id','" + jsEscape(lightProjectId) + "');put('CTL.P1.project_uid','" + jsEscape(lightProjectUid) + "');";
    code = code + "put('CTL.P1.image_id','" + jsEscape(lightImageId) + "');put('CTL.P1.image_uid','" + jsEscape(p1ImageUid) + "');put('CTL.P1.source_sha256','" + jsEscape(toLowerCase(lightSourceSha256)) + "');";
    if (p1MasterPixelSha256 != "") code = code + "put('CTL.P1.master_pixel_sha256','" + jsEscape(p1MasterPixelSha256) + "');";
    code = code + "put('CTL.P1.analysis_session_id','" + jsEscape(p1AnalysisSessionId) + "');put('CTL.P1.analysis_session_uid','" + jsEscape(p1AnalysisSessionUid) + "');";
    code = code + "put('CTL.P1.revision_id','NOT_APPLICABLE');put('CTL.P1.revision_uid','NOT_APPLICABLE');put('CTL.P1.working_state_id','" + jsEscape(p1WorkingStateId) + "');";
    code = code + "put('CTL.P1.generation_token','" + p1GenerationToken + "');put('CTL.P1.selection_revision','" + p1SelectionRevision + "');";
    code = code + "put('CTL.P1.scale_x_nm_px','" + d2s(nmPerPixelX,15) + "');put('CTL.P1.scale_y_nm_px','" + d2s(nmPerPixelY,15) + "');";
    code = code + "put('CTL.P1.scale_method','" + jsEscape(scaleMethod) + "');put('CTL.P1.resize_step_nm','" + d2s(lightInteractiveResizeStepNm,9) + "');";
    code = code + "put('CTL.P1.technical_preview','true');put('CTL.P1.scientific_validation','false');put('CTL.P1.functional_release','false');return 'OK';})();";
    result = "" + eval("js", code);
    if (result == "OK") return 1;
    return 0;
}


function p1StampCurrentRoiIdentity() {
    if (nImages() <= 0 || selectionType() == -1) return 0;
    if (!p1EnsureSessionIdentity()) return 0;
    objectUuid = Roi.getProperty("Object_uuid");
    if (objectUuid == "") {
        objectUuid = lightUuid();
        Roi.setProperty("Object_uuid", objectUuid);
        Roi.setProperty("Object_uuid_generation_method", "UUIDV4_RANDOM");
    }
    Roi.setProperty("object_uuid", objectUuid);
    cavityId = Roi.getProperty("Cavity_id");
    if (cavityId != "") Roi.setProperty("cavity_id", cavityId);
    Roi.setProperty("Project_id", lightProjectId);
    Roi.setProperty("Project_uid", lightProjectUid);
    Roi.setProperty("Image_id", lightImageId);
    Roi.setProperty("Image_uid", p1ImageUid);
    Roi.setProperty("Analysis_session_id", p1AnalysisSessionId);
    Roi.setProperty("Analysis_session_uid", p1AnalysisSessionUid);
    Roi.setProperty("Working_state_id", p1WorkingStateId);
    Roi.setProperty("Revision_id", "NOT_APPLICABLE");
    Roi.setProperty("Revision_uid", "NOT_APPLICABLE");
    Roi.setProperty("Generation_token", d2s(p1GenerationToken,0));
    return 1;
}


function p1CaptureOperationContext(commandId) {
    p1LastOperationContextJson = "";
    if (!p1EnsureRuntime() || !p1StampImageContext()) return "";
    code = "(function(){try{var IJ=Packages.ij.IJ,rt=IJ.getProperty('CTL.P1.Runtime'),imp=Packages.ij.WindowManager.getCurrentImage();return rt.capture(imp,'" + jsEscape(commandId) + "').json;}catch(ex){return 'ERROR|'+String(ex).replace(/[\\r\\n|]/g,' ');}})();";
    result = "" + eval("js", code);
    if (startsWith(result,"ERROR|")) {
        showStatus("CTL P1 contexto bloqueado: " + result);
        return "";
    }
    p1LastOperationContextJson = result;
    return result;
}


function p1ContextStillCurrent(contextJson) {
    if (!p1EnsureRuntime() || contextJson == "") return 0;
    code = "(function(){try{var IJ=Packages.ij.IJ,rt=IJ.getProperty('CTL.P1.Runtime'),wanted=JSON.parse('" + jsEscape(contextJson) + "'),imp=Packages.ij.WindowManager.getCurrentImage();if(imp==null)return '0';var live=rt.capture(imp,String(wanted.command_id));return live.context_fingerprint_sha256==String(wanted.context_fingerprint_sha256)?'1':'0';}catch(ex){return '0';}})();";
    result = "" + eval("js",code);
    if (result == "1") return 1;
    return 0;
}


function p1AwaitEvt006PrepareSwitch(contextJson) {
    // p1RunTransactionalOperation has already passed the runtime/master gate.
    // Avoid rebuilding the large embedded Base64 on the marker-absent path.
    if (contextJson == "") return "FAIL|EVT006_BARRIER_CONTEXT_ABSENT";
    code = "(function(){try{var IJ=Packages.ij.IJ,rt=IJ.getProperty('CTL.P1.Runtime');if(rt==null||typeof rt.awaitEvt006PrepareSwitch!='function')throw new Error('EVT006_BARRIER_API_ABSENT');return String(rt.awaitEvt006PrepareSwitch('" + jsEscape(contextJson) + "'));}catch(ex){return 'FAIL|'+String(ex).replace(/[\\r\\n\\t|]/g,' ');}})();";
    return "" + eval("js",code);
}


function p1AuditStale(contextJson, operation) {
    code = "(function(){var imp=Packages.ij.WindowManager.getCurrentImage();if(imp!=null){imp.setProperty('CTL.P1.last_event','STALE_CONTEXT_CANCELLED');imp.setProperty('CTL.P1.last_event_detail','" + jsEscape(operation) + "');imp.setProperty('CTL.P1.last_event_mutations','0');imp.setProperty('CTL.P1.last_event_roi_manager_changes','0');imp.setProperty('CTL.P1.last_event_disk_writes','AUDIT_EVENT_ONLY');}Packages.ij.IJ.log('CTL P1 STALE_CONTEXT_CANCELLED: " + jsEscape(operation) + "');return 'OK';})();";
    eval("js",code);
}


function p1VerifyMaster() {
    if (nImages() <= 0 || !p1EnsureRuntime()) return "NOT_VERIFIED";
    if (!p1StampImageContext()) return "NOT_VERIFIED";
    sourcePath = p1ResolveSourcePathReadOnly();
    if (sourcePath == "") return "NOT_VERIFIED";
    expectedPixel = p1ImageProperty("CTL.P1.master_pixel_sha256_expected");
    code = "(function(){try{var IJ=Packages.ij.IJ,rt=IJ.getProperty('CTL.P1.Runtime'),imp=Packages.ij.WindowManager.getCurrentImage();return String(rt.verifyMaster(imp,'" + jsEscape(sourcePath) + "','" + jsEscape(toLowerCase(lightSourceSha256)) + "','" + jsEscape(toLowerCase(expectedPixel)) + "'));}catch(ex){return 'NOT_VERIFIED';}})();";
    p1MasterPixelHashStatus = "" + eval("js",code);
    if (p1MasterPixelHashStatus == "VERIFIED") p1MasterPixelSha256 = toLowerCase(expectedPixel);
    else {
        p1MasterPixelSha256 = "";
        eval("js","var imp=Packages.ij.WindowManager.getCurrentImage();if(imp!=null)imp.setProperty('CTL.P1.master_pixel_sha256',null);");
    }
    return p1MasterPixelHashStatus;
}


function p1VerifyMasterReadOnly() {
    status = p1VerifyMaster();
    if (status == "VERIFIED") showMessage("Master P1 verificado", "source_sha256 y master_pixel_sha256 coinciden. La verificacion fue exclusivamente read-only.");
    else if (status == "MISMATCH") showMessage("Master P1 rechazado", "source_sha256 o master_pixel_sha256 no coincide. No se realizo ninguna escritura cientifica.");
    else showMessage("Master P1 no verificado", "Falta evidencia cerrada suficiente. No se realizo ninguna escritura cientifica.");
}


function p1RequireScientificWrite(actionText) {
    status = p1VerifyMaster();
    if (status == "VERIFIED") {
        if (!p1EnsureRuntime()) status = "NOT_VERIFIED";
        else {
            gateCode = "(function(){try{var IJ=Packages.ij.IJ,rt=IJ.getProperty('CTL.P1.Runtime'),imp=Packages.ij.WindowManager.getCurrentImage();if(rt==null||imp==null||typeof rt.scientificWriteAllowed!='function')throw new Error('runtime_gate_missing');return rt.scientificWriteAllowed(imp)?'ALLOWED':'BLOCKED';}catch(ex){return 'ERROR|'+String(ex).replace(/[\\r\\n|]/g,' ');}})();";
            gateStatus = "" + eval("js",gateCode);
            if (gateStatus == "ALLOWED") return 1;
            status = "NOT_VERIFIED";
        }
    }
    code = "(function(){try{var IJ=Packages.ij.IJ,rt=IJ.getProperty('CTL.P1.Runtime'),imp=Packages.ij.WindowManager.getCurrentImage();if(rt==null||imp==null)throw new Error('runtime_or_image_missing');rt.telemetryBlocked(imp,'" + jsEscape(actionText) + "','" + jsEscape(status) + "');return 'OK';}catch(ex){return 'ERROR|'+String(ex).replace(/[\\r\\n|]/g,' ');}})();";
    telemetryStatus = "" + eval("js",code);
    if (startsWith(telemetryStatus,"ERROR|")) showStatus("CTL P1 bloqueo telemetrico: " + telemetryStatus);
    if (status == "MISMATCH") showMessage("Fuente rechazada", "CTL P1 detecto MISMATCH de source/master pixels. " + actionText + " queda bloqueado.");
    else showMessage("Solo inspeccion read-only", "master_pixel_hash_status=NOT_VERIFIED. CTL P1 permite inspeccion/migracion read-only, pero bloquea " + actionText + ".");
    return 0;
}


function p1InstallInteractionListeners(verbose) {
    if (nImages() <= 0 || !p1EnsureRuntime()) return;
    p1StampImageContext();
    code = "(function(){var IJ=Packages.ij.IJ,rt=IJ.getProperty('CTL.P1.Runtime');return String(rt.install(Packages.ij.WindowManager.getCurrentImage()));})();";
    result = "" + eval("js",code);
    lightInteractiveControllerStatus = result;
    if (verbose) showStatus("CTL P1 listeners: " + result);
}


function p1QueueCommand(commandId, internalMacro, requireVerifiedMaster) {
    if (requireVerifiedMaster && !p1RequireScientificWrite(commandId)) return;
    contextJson = p1CaptureOperationContext(commandId);
    if (contextJson == "") return;
    code = "(function(){try{var IJ=Packages.ij.IJ,rt=IJ.getProperty('CTL.P1.Runtime'),imp=Packages.ij.WindowManager.getCurrentImage(),ctx=rt.capture(imp,'" + jsEscape(commandId) + "');rt.submit(ctx,'" + jsEscape(commandId) + "','" + jsEscape(internalMacro) + "',false,null);return 'QUEUED';}catch(ex){return 'ERROR|'+String(ex).replace(/[\\r\\n|]/g,' ');}})();";
    result = "" + eval("js",code);
    showStatus("CTL P1 " + commandId + ": " + result);
}


function p1BridgePayloadParametersJson() {
    updateScaleMaybe();
    method = p1ImageProperty("CTL.P1.scale_method");
    if (method == "") method = lightScaleOrigin;
    if (method == "") method = "NOT_VERIFIED";
    thicknessStatus = "UNKNOWN";
    if (lightThicknessNm > 0) thicknessStatus = "KNOWN";
    a = "{";
    a = a + "\"scale_x_nm_px\":" + jsonNumber(nmPerPixelX) + ",\"scale_y_nm_px\":" + jsonNumber(nmPerPixelY) + ",";
    a = a + "\"scale_method\":\"" + jsonEscape(method) + "\",";
    a = a + "\"analysis_parameters\":{";
    a = a + "\"classification_policy\":\"PRIMARY_CONFIRMED_ONLY_WITH_SENSITIVITY\",\"validity_update_mode\":\"INDEPENDENT_FLAGS\",";
    a = a + "\"image_mode\":\"" + jsonEscape(lightImageMode) + "\",\"use_whole_image\":" + lightUseWholeImage + ",";
    a = a + "\"thickness_nm\":" + jsonNumber(lightThicknessNm) + ",\"thickness_status\":\"" + thicknessStatus + "\",";
    a = a + "\"histogram_bin_nm\":" + jsonNumber(lightHistogramBinNm) + ",\"feature_distance_bin_nm\":" + jsonNumber(lightFeatureDistanceBinNm) + "},";
    base = "images/" + lightImageId;
    a = a + "\"revisions_relative_path\":\"" + jsonEscape(base + "/roi_sessions") + "\",";
    a = a + "\"current_run_pointer_relative_path\":\"" + jsonEscape(base + "/current_run.tsv") + "\",";
    a = a + "\"run_registry_relative_path\":\"" + jsonEscape(base + "/run_registry.json") + "\",";
    a = a + "\"runs_relative_path\":\"" + jsonEscape(base + "/measurement_runs") + "\",";
    ids = p1ImageProperty("CTL.P1.combined_selected_image_ids");
    idArray = split(ids,";");
    a = a + "\"selected_image_ids\":[";
    pointerJson = "";
    for (pi=0; pi<idArray.length; pi++) {
        if (idArray[pi] == "") continue;
        if (pointerJson != "") pointerJson = pointerJson + ",";
        pointerJson = pointerJson + "\"" + jsonEscape(idArray[pi]) + "\"";
    }
    a = a + pointerJson + "],\"current_run_pointer_relative_paths\":[";
    pointerJson = "";
    for (pi=0; pi<idArray.length; pi++) {
        if (idArray[pi] == "") continue;
        if (pointerJson != "") pointerJson = pointerJson + ",";
        pointerJson = pointerJson + "\"images/" + jsonEscape(idArray[pi]) + "/current_run.tsv\"";
    }
    a = a + pointerJson + "],\"combined_runs_relative_path\":\"combined_runs\",";
    a = a + "\"load_revision_relative_path\":\"" + jsonEscape(p1LoadRevisionRelativePath) + "\",";
    a = a + "\"current_revision_pointer_relative_path\":\"" + jsonEscape(base + "/current_revision_p1.json") + "\",";
    a = a + "\"load_working_state_id\":\"" + jsonEscape(p1LoadWorkingStateId) + "\"}";
    return a;
}


function p1BridgeCall(operation, phase, contextJson, prepareToken) {
    if (!p1EnsureRuntime()) return "FAIL|RUNTIME_UNAVAILABLE";
    if (operatorName == "") return "FAIL|OPERATOR_ID_REQUIRED";
    parametersJson = "";
    if (phase == "PREPARE" || phase == "EXECUTE") parametersJson = p1BridgePayloadParametersJson();
    sourcePath = p1ResolveSourcePathReadOnly();
    if (sourcePath == "") return "FAIL|CONTROLLED_LOCAL_SOURCE_UNAVAILABLE";
