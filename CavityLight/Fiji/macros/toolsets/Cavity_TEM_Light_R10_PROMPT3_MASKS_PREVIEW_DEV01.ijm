function p1EnsureRuntime() {
    b64 = p1EmbeddedRuntimeBase64();
    code = "(function(){var IJ=Packages.ij.IJ,current=IJ.getProperty('CTL.P1.Runtime'),B=Packages.java.util.Base64,CS=Packages.java.nio.charset.StandardCharsets,MD=Packages.java.security.MessageDigest;";
    code = code + "function hex(a){var s='',v;for(var i=0;i<a.length;i++){v=a[i];if(v<0)v+=256;if(v<16)s+='0';s+=v.toString(16);}return s;}";
    code = code + "try{if(current!=null&&String(current.version)=='" + p1RuntimeVersion + "'&&String(current.buildIdentity)=='" + p1RuntimeBuildIdentity + "'&&String(current.telemetrySchema)=='CTL_P1_RUNTIME_TELEMETRY_V1'&&typeof current.telemetryConfigure=='function'&&typeof current.telemetrySnapshot=='function'&&typeof current.telemetryEvent=='function'&&typeof current.telemetryBlocked=='function'&&typeof current.awaitEvt006PrepareSwitch=='function')return 'OK|'+String(current.version)+'|'+String(current.buildIdentity);var bytes=B.getDecoder().decode('" + b64 + "'),actual=hex(MD.getInstance('SHA-256').digest(bytes));";
    code = code + "if(actual!='" + p1EmbeddedRuntimeSourceSha256 + "')return 'ERROR|EMBEDDED_RUNTIME_SHA256_MISMATCH|'+actual;";
    code = code + "var source=String(new java.lang.String(bytes,CS.UTF_8)),api=eval(source);if(api==null||String(api.version)!='" + p1RuntimeVersion + "')return 'ERROR|RUNTIME_VERSION_MISMATCH';if(String(api.buildIdentity)!='" + p1RuntimeBuildIdentity + "')return 'ERROR|RUNTIME_BUILD_IDENTITY_MISMATCH';return 'OK|'+String(api.version)+'|'+String(api.buildIdentity);";
    code = code + "}catch(ex){return 'ERROR|'+String(ex).replace(/[\\r\\n|]/g,' ');}})();";
    status = "" + eval("js", code);
    if (!startsWith(status, "OK|")) {
        showStatus("CTL P1 runtime bloqueado: " + status);
        return 0;
    }
    return 1;
}


function p1EnsureSessionIdentity() {
    if (nImages() <= 0) return 0;
    if (!p1EnsureRuntime()) return 0;
    legacySessionId = p1ImageProperty("CTL.P1.legacy_analysis_session_id");
    if (legacySessionId == "NOT_APPLICABLE") legacySessionId = "";
    legacySessionJs = "null";
    if (legacySessionId != "") legacySessionJs = "'" + jsEscape(legacySessionId) + "'";
    code = "(function(){try{var IJ=Packages.ij.IJ,rt=IJ.getProperty('CTL.P1.Runtime'),imp=Packages.ij.WindowManager.getCurrentImage();if(rt==null||imp==null)throw new Error('runtime_or_image_missing');";
    code = code + "var identity=rt.deriveLegacyImageIdentity('" + jsEscape(lightProjectRoot) + "','" + jsEscape(lightProjectUid) + "','" + jsEscape(lightImageId) + "'," + legacySessionJs + ");";
    code = code + "function bind(k,v){var old=imp.getProperty(k);if(old!=null&&String(old)!=''&&String(old)!=String(v))throw new Error('identity_evidence_conflict:'+k);imp.setProperty(k,String(v));}";
    code = code + "bind('CTL.P1.image_uid',identity.image_uid);bind('CTL.P1.image_uid_generation_method',identity.image_uid_generation_method);bind('CTL.P1.image_uid_name_template_id',identity.image_uid_name_template_id);bind('CTL.P1.image_uid_name_utf8_sha256',identity.image_uid_name_utf8_sha256);bind('CTL.P1.image_parent_identity_component',identity.image_parent_identity_component);";
    code = code + "bind('CTL.P1.legacy_image_parent_identity_token',identity.legacy_image_parent_identity_token);bind('CTL.P1.legacy_image_parent_identity_token_method',identity.legacy_image_parent_identity_token_method);bind('CTL.P1.legacy_image_registry_relative_path',identity.legacy_image_registry_relative_path);bind('CTL.P1.legacy_image_registry_row_ordinal',identity.legacy_image_registry_row_ordinal);bind('CTL.P1.legacy_image_registry_row_sha256',identity.legacy_image_registry_row_sha256);";
    code = code + "bind('CTL.P1.analysis_session_id',identity.analysis_session_id);bind('CTL.P1.analysis_session_id_origin',identity.analysis_session_id_origin);bind('CTL.P1.analysis_session_uid',identity.analysis_session_uid);bind('CTL.P1.analysis_session_uid_generation_method',identity.analysis_session_uid_generation_method);bind('CTL.P1.analysis_session_uid_name_template_id',identity.analysis_session_uid_name_template_id);bind('CTL.P1.analysis_session_uid_name_utf8_sha256',identity.analysis_session_uid_name_utf8_sha256);bind('CTL.P1.legacy_analysis_session_id',identity.legacy_analysis_session_id);bind('CTL.P1.legacy_analysis_session_identity_component',identity.legacy_analysis_session_identity_component);bind('CTL.P1.legacy_analysis_session_identity_component_origin',identity.legacy_analysis_session_identity_component_origin);";
    code = code + "return 'OK\\t'+identity.image_uid+'\\t'+identity.analysis_session_id+'\\t'+identity.analysis_session_uid;}catch(ex){return 'ERROR|'+String(ex).replace(/[\\r\\n\\t|]/g,' ');}})();";
    identityResult = "" + eval("js", code);
    if (startsWith(identityResult,"ERROR|")) {
        showStatus("CTL P1 identidad WP-17 bloqueada: " + identityResult);
        return 0;
    }
    identityFields = split(identityResult,"\t");
    if (identityFields.length != 4 || identityFields[0] != "OK") return 0;
    p1ImageUid = identityFields[1];
    p1AnalysisSessionId = identityFields[2];
    p1AnalysisSessionUid = identityFields[3];
    existingWorking = p1ImageProperty("CTL.P1.working_state_id");
    if (existingWorking != "") p1WorkingStateId = existingWorking;
    if (p1WorkingStateId == "") p1WorkingStateId = "WORKING_" + substring(replace(lightUuid(),"-",""),0,16);
    if (p1GenerationToken < 1) p1GenerationToken = 1;
    return 1;
}


function p1ResetExpectedPixelBindingGlobals() {
    p1MasterPixelSha256 = "";
    p1MasterPixelHashStatus = "NOT_VERIFIED";
    p1ExpectedPixelBindingStatus = "NOT_BOUND";
}


function p1ResetImageScopedRuntimeGlobals() {
    p1ImageUid = "";
    p1AnalysisSessionId = "";
    p1AnalysisSessionUid = "";
    p1WorkingStateId = "";
    p1GenerationToken = 1;
    p1SelectionRevision = 0;
    p1LastOperationContextJson = "";
    p1ResetExpectedPixelBindingGlobals();
}


function p1ClearCurrentExpectedPixelBindingInMemory() {
    p1ResetExpectedPixelBindingGlobals();
    if (nImages() <= 0) return 1;
    code = "(function(){var imp=Packages.ij.WindowManager.getCurrentImage(),keys=['CTL.P1.source_sha256_actual','CTL.P1.source_hash_status','CTL.P1.master_pixel_sha256','CTL.P1.master_pixel_sha256_actual','CTL.P1.master_pixel_sha256_expected','CTL.P1.master_pixel_sha256_expected_method','CTL.P1.master_pixel_sha256_expected_origin_schema','CTL.P1.master_pixel_sha256_expected_origin_sha256','CTL.P1.master_pixel_sha256_expected_origin_path','CTL.P1.master_pixel_sha256_expected_origin_implementation_commit','CTL.P1.master_pixel_sha256_expected_origin_source_sha256','CTL.P1.master_pixel_sha256_expected_origin_image_id','CTL.P1.master_pixel_sha256_expected_origin_binding_key','CTL.P1.master_pixel_sha256_expected_origin_install_config_sha256','CTL.P1.master_pixel_sha256_expected_origin_staging_record_sha256','CTL.P1.master_pixel_sha256_expected_binding_status','CTL.P1.master_pixel_hash_error','CTL.P1.master_pixel_hash_method','CTL.P1.master_width_px','CTL.P1.master_height_px','CTL.P1.image_role'];if(imp==null)return 'OK';for(var i=0;i<keys.length;i++)imp.setProperty(keys[i],null);imp.setProperty('CTL.P1.source_hash_status','NOT_VERIFIED');imp.setProperty('CTL.P1.master_pixel_hash_status','NOT_VERIFIED');return 'OK';})();";
    clearResult = "" + eval("js", code);
    if (clearResult == "OK") return 1;
    return 0;
}


function p1ConfigureExpectedPixelFreezeRootReadOnly() {
    selectedFreezeRoot = getDirectory("Selecciona la raiz EXTERNA de freezes P1 (solo lectura)");
    if (selectedFreezeRoot == "") return 0;
    p1ExpectedPixelFreezeRoot = normalizeStoredPath(selectedFreezeRoot);
    p1ClearCurrentExpectedPixelBindingInMemory();
    showStatus("Raiz externa de freezes P1 configurada solo en memoria.");
    return 1;
}


function p1BindExpectedPixelFreezeReadOnly() {
    if (nImages() <= 0) return 0;
    if (p1ExpectedPixelFreezeRoot == "" && !p1ConfigureExpectedPixelFreezeRootReadOnly()) return 0;
    if (lightImageId == "" || lightSourceSha256 == "") return 0;
    sourcePath = p1ResolveSourcePathReadOnly();
    if (sourcePath == "") return 0;
    if (!p1ClearCurrentExpectedPixelBindingInMemory()) return 0;
    code = "(function(){try{var IJ=Packages.ij.IJ,WM=Packages.ij.WindowManager,F=Packages.java.io.File,Files=Packages.java.nio.file.Files,MD=Packages.java.security.MessageDigest,CS=Packages.java.nio.charset.StandardCharsets,imp=WM.getCurrentImage(),root=new F('" + jsEscape(p1ExpectedPixelFreezeRoot) + "').getCanonicalFile(),imageId='" + jsEscape(lightImageId) + "',sourceSha='" + jsEscape(toLowerCase(lightSourceSha256)) + "',sourceFile=new F('" + jsEscape(sourcePath) + "').getCanonicalFile(),projectRoot=new F('" + jsEscape(lightProjectRoot) + "').getCanonicalFile(),fijiRoot=new F(IJ.getDirectory('imagej')).getCanonicalFile(),pluginRoot=new F(IJ.getDirectory('plugins'),'Cavity_TEM_Light').getCanonicalFile();";
    code = code + "function req(c,m){if(!c)throw new Error(m);}function hex(a){var s='',v;for(var i=0;i<a.length;i++){v=a[i];if(v<0)v+=256;if(v<16)s+='0';s+=v.toString(16);}return s;}function shaBytes(b){return hex(MD.getInstance('SHA-256').digest(b));}function shaFile(f){return shaBytes(Files.readAllBytes(f.toPath()));}function exact(o,n){if(o==null||typeof o!='object'||Array.isArray(o))return false;var a=Object.keys(o).sort(),b=n.split('|').sort();return a.length===b.length&&a.join('|')===b.join('|');}function ordered(v){if(Array.isArray(v)){var a=[];for(var i=0;i<v.length;i++)a.push(ordered(v[i]));return a;}if(v!=null&&typeof v==='object'){var o={},k=Object.keys(v).sort();for(var j=0;j<k.length;j++)o[k[j]]=ordered(v[k[j]]);return o;}return v;}function lowerPath(f){return String(f.getCanonicalPath()).toLowerCase();}function under(f,r){var p=lowerPath(f),q=lowerPath(r),sep=String(F.separator);return p===q||p.indexOf(q+sep)===0;}function plainFile(f){return f.isFile()&&!Files.isSymbolicLink(f.toPath());}function posInt(v){return typeof v==='number'&&isFinite(v)&&Math.floor(v)===v&&v>0;}";
    code = code + "req(imp!=null,'NO_IMAGE');req(root.isDirectory(),'FREEZE_ROOT_NOT_DIRECTORY');req(!under(root,projectRoot)&&!under(projectRoot,root)&&!under(root,fijiRoot)&&!under(fijiRoot,root)&&!under(root,pluginRoot)&&!under(pluginRoot,root),'FREEZE_ROOT_NOT_EXTERNAL');req(/^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$/.test(imageId),'IMAGE_ID_PATH_UNSAFE');req(/^[0-9a-f]{64}$/.test(sourceSha),'SOURCE_SHA256_INVALID');var imageDir=new F(root,imageId).getCanonicalFile();req(imageDir.getParentFile().equals(root),'IMAGE_DIRECTORY_ESCAPE');var leaf=new F(imageDir,sourceSha).getCanonicalFile();req(leaf.getParentFile().equals(imageDir)&&leaf.isDirectory(),'FREEZE_BINDING_LEAF_MISSING');var listed=leaf.list(),names=[];req(listed!=null,'FREEZE_BINDING_LEAF_UNREADABLE');for(var ni=0;ni<listed.length;ni++)names.push(String(listed[ni]));names.sort();req(names.join('|')==='CTL_MASTER_PIXEL_SHA256_V1_EXPECTED_FREEZE.json|CTL_MASTER_PIXEL_SHA256_V1_EXPECTED_FREEZE.json.sha256','FREEZE_BINDING_LEAF_NOT_CLOSED');";
    code = code + "var freeze=new F(leaf,'CTL_MASTER_PIXEL_SHA256_V1_EXPECTED_FREEZE.json').getCanonicalFile(),sidecar=new F(leaf,'CTL_MASTER_PIXEL_SHA256_V1_EXPECTED_FREEZE.json.sha256').getCanonicalFile();req(freeze.getParentFile().equals(leaf)&&sidecar.getParentFile().equals(leaf)&&plainFile(freeze)&&plainFile(sidecar),'FREEZE_FILES_NOT_PLAIN');var raw=Files.readAllBytes(freeze.toPath()),sideBytes=Files.readAllBytes(sidecar.toPath()),sideText=String(new java.lang.String(sideBytes,CS.US_ASCII)),match=/^([0-9a-f]{64})  ([1-9][0-9]*)  CTL_MASTER_PIXEL_SHA256_V1_EXPECTED_FREEZE.json\\n$/.exec(sideText);req(match!=null,'FREEZE_SIDECAR_INVALID');var actual=shaBytes(raw);req(actual===match[1]&&Number(match[2])===raw.length,'FREEZE_SIDECAR_MISMATCH');var decoded=new java.lang.String(raw,CS.UTF_8),text=String(decoded),roundTrip=decoded.getBytes(CS.UTF_8);req(raw.length>0&&!(raw.length>=3&&Number(raw[0])===-17&&Number(raw[1])===-69&&Number(raw[2])===-65)&&java.util.Arrays.equals(raw,roundTrip)&&text.indexOf('\\r')<0&&/\\n$/.test(text),'FREEZE_JSON_ENCODING_INVALID');var e=JSON.parse(text);req(text===JSON.stringify(ordered(e),null,2)+'\\n','FREEZE_JSON_NOT_CANONICAL');";
    code = code + "req(exact(e,'bio_formats|claim_boundary|classification|controlled_source|evidence_schema|expected_pixel_freeze_candidate|implementation_commit|master_pixel|normalized_payload|probe_descriptor|public_distribution_ready|staging_evidence|status|t_view_001'),'FREEZE_FIELDS_NOT_CLOSED');req(e.evidence_schema==='CTL_MASTER_PIXEL_EXPECTED_FREEZE_V1'&&e.classification==='RESTRICTED_LOCAL_CAMPAIGN_EVIDENCE'&&e.status==='EXPECTED_PIXEL_FROZEN_PENDING_T_VIEW_001'&&e.t_view_001==='NOT_RUN'&&e.expected_pixel_freeze_candidate===true&&e.public_distribution_ready===false,'FREEZE_STATE_INVALID');var claims=e.claim_boundary;req(exact(claims,'P2_FULL_SUPPLEMENT_READY|fiji_real_executed|final_version|functional_release|global_release|installer_executed|prompt2_started|public_distribution_ready|r10_final_status|scientific_validation|test_pass_assigned'),'FREEZE_CLAIMS_FIELDS');req(claims.P2_FULL_SUPPLEMENT_READY===false&&claims.fiji_real_executed===false&&claims.final_version===false&&claims.functional_release===false&&claims.global_release===false&&claims.installer_executed===false&&claims.prompt2_started===false&&claims.public_distribution_ready===false&&claims.r10_final_status==='NOT_GRANTED'&&claims.scientific_validation===false&&claims.test_pass_assigned===false,'FREEZE_FORBIDDEN_CLAIM');";
    code = code + "var configFile=new F(pluginRoot,'p1_runtime_config.json'),stageFile=new F(pluginRoot,'campaign_staging_record.json');req(plainFile(configFile)&&plainFile(stageFile),'STAGING_BINDING_FILES_ABSENT');var config=JSON.parse(String(new java.lang.String(Files.readAllBytes(configFile.toPath()),CS.UTF_8))),stage=JSON.parse(String(new java.lang.String(Files.readAllBytes(stageFile.toPath()),CS.UTF_8))),commit=String(e.implementation_commit||''),configSha=shaFile(configFile);req(config.schema==='CTL_P1_RUNTIME_CONFIG_V2'&&config.install_mode==='STAGING_NOT_PRODUCTION_INSTALLER'&&config.candidate_id==='Cavity_TEM_Light_v1_2_0_R10_DEV01'&&stage.schema==='CTL_P1_FIJI_CAMPAIGN_STAGING_V1'&&stage.install_mode==='STAGING_NOT_PRODUCTION_INSTALLER'&&stage.candidate_id===config.candidate_id&&stage.classification==='RESTRICTED_LOCAL_CAMPAIGN_EVIDENCE'&&stage.claim_boundary&&stage.claim_boundary.test_pass_assigned===false&&stage.runtime_config_sha256===configSha,'STAGING_BINDING_INVALID');req(/^[0-9a-f]{40}$/.test(commit)&&String(config.implementation_commit)===commit&&String(stage.implementation_commit)===commit,'FREEZE_IMPLEMENTATION_COMMIT_MISMATCH');";
    code = code + "req(exact(e.controlled_source,'bytes|sha256')&&e.controlled_source.sha256===sourceSha&&posInt(e.controlled_source.bytes),'FREEZE_SOURCE_INVALID');req(sourceFile.isFile()&&Number(sourceFile.length())===e.controlled_source.bytes&&shaFile(sourceFile)===sourceSha,'LIVE_SOURCE_IDENTITY_MISMATCH');var m=e.master_pixel;req(exact(m,'bit_depth|channels|frames|height|method|sha256|slices|width')&&m.method==='CTL_MASTER_PIXEL_SHA256_V1'&&/^[0-9a-f]{64}$/.test(String(m.sha256||''))&&posInt(m.width)&&posInt(m.height)&&posInt(m.bit_depth)&&(m.bit_depth===8||m.bit_depth===16||m.bit_depth===24||m.bit_depth===32)&&m.channels===1&&m.slices===1&&m.frames===1,'FREEZE_MASTER_INVALID');req(m.width===Number(imp.getWidth())&&m.height===Number(imp.getHeight())&&m.bit_depth===Number(imp.getBitDepth())&&Number(imp.getStackSize())===1&&Number(imp.getNChannels())===1&&Number(imp.getNSlices())===1&&Number(imp.getNFrames())===1,'FREEZE_DIMENSIONS_MISMATCH');req(exact(e.bio_formats,'decoder|jar_sha256')&&e.bio_formats.decoder==='loci.plugins.BF.openImagePlus'&&/^[0-9a-f]{64}$/.test(String(e.bio_formats.jar_sha256||'')),'FREEZE_DECODER_INVALID');var bpp=m.bit_depth===24?3:m.bit_depth/8;req(exact(e.normalized_payload,'bytes|sha256')&&posInt(e.normalized_payload.bytes)&&e.normalized_payload.bytes===m.width*m.height*bpp&&/^[0-9a-f]{64}$/.test(String(e.normalized_payload.sha256||'')),'FREEZE_PAYLOAD_INVALID');req(exact(e.probe_descriptor,'bytes|imagej_version|sha256')&&posInt(e.probe_descriptor.bytes)&&String(e.probe_descriptor.imagej_version||'')!==''&&/^[0-9a-f]{64}$/.test(String(e.probe_descriptor.sha256||'')),'FREEZE_PROBE_INVALID');req(exact(e.staging_evidence,'bytes|sha256')&&posInt(e.staging_evidence.bytes)&&/^[0-9a-f]{64}$/.test(String(e.staging_evidence.sha256||'')),'FREEZE_STAGING_EVIDENCE_INVALID');";
