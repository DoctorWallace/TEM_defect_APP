    code = code + "function pubTarget(){return opClass=='SAVE_REVISION'?'REVISION':(opClass=='EXPORT_RUN'?'RUN':'NONE');}function writeTarget(){return opClass=='SAVE_REVISION'?'REVISION_STAGING':(opClass=='EXPORT_RUN'?'RUN_STAGING':'NONE');}function emit(et,ph,st,j,pa,pt,pr,wa,wt,wr,detail){return rt.telemetryEvent({event_type:et,imp:imp,owner_context:providedContext,request_id:requestId,transaction_id:transactionId,operation:opClass,phase:ph,status:st,journal_state:j,publication_attempted:pa,publication_target_class:pt,publication_result:pr,write_attempted:wa,write_target_class:wt,write_result:wr,detail_code:detail});}function failed(value){if(bridgeRequested){if(phase=='COMMIT'){emit('PUBLICATION_ATTEMPT','COMMIT','FAILED','NOT_APPLICABLE',true,pubTarget(),'FAILED',true,writeTarget(),'FAILED','BRIDGE_PUBLICATION_FAILED');emit('TRANSACTION_PHASE','ROLLBACK','FAILED','FAILED_PARTIAL',false,pubTarget(),'FAILED',false,writeTarget(),'FAILED','BRIDGE_TRANSACTION_FAILED_PARTIAL');}else if(phase=='ABORT'){emit('TRANSACTION_PHASE','ROLLBACK','FAILED','FAILED_PARTIAL',false,pubTarget(),'ROLLED_BACK',false,writeTarget(),'FAILED','BRIDGE_ROLLBACK_FAILED_PARTIAL');}emit('BRIDGE_COMPLETED','COMPLETE','FAILED','NOT_APPLICABLE',false,pubTarget(),'FAILED',false,writeTarget(),'FAILED','BRIDGE_REQUEST_FAILED');}return 'FAIL|'+clean(value);}";
