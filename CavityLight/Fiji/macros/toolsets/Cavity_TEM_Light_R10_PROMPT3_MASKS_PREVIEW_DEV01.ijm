macro "Cavity Light: configurar freezes P1 read-only" { p1ConfigureExpectedPixelFreezeRootReadOnly(); }
macro "Cavity Light: ligar y verificar freeze P1 actual" { p1BindAndVerifyExpectedPixelFreezeReadOnly(); }
