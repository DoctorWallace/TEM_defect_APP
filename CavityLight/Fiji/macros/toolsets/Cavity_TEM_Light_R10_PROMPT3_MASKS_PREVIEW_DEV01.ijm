function p1CaptureScientificSelectionToken() {
    if (nImages() <= 0) return "NEUTRAL";
    code = "(function(){var RM=Packages.ij.plugin.frame.RoiManager,WM=Packages.ij.WindowManager,RE=Packages.ij.io.RoiEncoder,MD=Packages.java.security.MessageDigest,rm=RM.getInstance2(),imp=WM.getCurrentImage();";
    code = code + "function val(r,k){var v=r==null?null:r.getProperty(k);return v==null?'':String(v);}";
    code = code + "function norm(t){t=String(t||'');if(t=='analysis_area'||t=='mask')return 'analysis_mask';if(t=='surface')return 'surface_reference';return t;}";
    code = code + "function typ(r){var a=norm(val(r,'Type')),b=norm(val(r,'Object_type'));if(a!=''&&b!=''&&a!=b)return 'TYPE_CONFLICT';return a!=''?a:b;}";
    code = code + "function scientific(t){return t=='cavity'||t=='panel'||t=='analysis_mask'||t=='exclusion'||t=='dislocation_loop'||t=='grain_boundary'||t=='dislocation'||t=='interface'||t=='scale_reference'||t=='surface_reference';}";
    code = code + "function oid(r,t){var id='',primary='',alias='';if(t=='cavity'){primary=val(r,'Cavity_id');alias=val(r,'cavity_id');if(primary!=''&&alias!=''&&primary!=alias)return 'ID_CONFLICT';id=primary!=''?primary:alias;}else if(t=='panel'){id=val(r,'Panel_id');if(id=='')id=val(r,'Object_id');}else if(t=='analysis_mask'){id=val(r,'Mask_id');if(id=='')id=val(r,'Object_id');}else if(t=='exclusion'){id=val(r,'Exclusion_id');if(id=='')id=val(r,'Object_id');}else if(t=='dislocation_loop'){id=val(r,'Object_id');if(id=='')id=val(r,'Feature_id');}else{id=val(r,'Feature_id');if(id=='')id=val(r,'Object_id');}if(id=='')id=String(r.getName()||'');return id;}";
    code = code + "function sha(r){try{var b=RE.saveAsByteArray(r),d=MD.getInstance('SHA-256').digest(b),s='';for(var i=0;i<d.length;i++){var v=Number(d[i])&255;s+=(v<16?'0':'')+v.toString(16);}return s;}catch(ex){return '';}}";
    code = code + "function token(r){var t=typ(r);if(t=='TYPE_CONFLICT')return 'INVALID_SCIENTIFIC';if(r==null||!scientific(t))return '';var up=val(r,'Object_uuid'),ua=val(r,'object_uuid');if(up!=''&&ua!=''&&up!=ua)return 'INVALID_SCIENTIFIC';var u=up!=''?up:ua,id=oid(r,t),h=sha(r);if(id=='ID_CONFLICT'||u==''||id==''||h==''||u.indexOf('|')>=0||id.indexOf('|')>=0)return 'INVALID_SCIENTIFIC';return 'ROI|'+t+'|'+u+'|'+id+'|'+h;}";
    code = code + "var mi=rm==null?-1:rm.getSelectedIndex(),mr=mi>=0&&mi<rm.getCount()?rm.getRoi(mi):null,ir=imp==null?null:imp.getRoi(),mt=token(mr),it=token(ir);";
    code = code + "if(mt=='INVALID_SCIENTIFIC'||it=='INVALID_SCIENTIFIC'||(mt!='')!=(it!='')||(mt!=''&&it!=''&&mt!=it))return 'CONFLICT';return mt!=''?mt:'NEUTRAL';})()";
    return "" + eval("js", code);
}


function p1FindScientificSelectionIndex(objectType, objectUuid, objectIdValue, objectStateSha256) {
    if (objectType == "" || objectUuid == "" || objectIdValue == "" || objectStateSha256 == "") return -1;
    code = "(function(){var RM=Packages.ij.plugin.frame.RoiManager,RE=Packages.ij.io.RoiEncoder,MD=Packages.java.security.MessageDigest,rm=RM.getInstance2(),wantedType='" + jsEscape(objectType) + "',wantedUuid='" + jsEscape(objectUuid) + "',wantedId='" + jsEscape(objectIdValue) + "',wantedSha='" + jsEscape(objectStateSha256) + "',found=-1;";
    code = code + "if(rm==null)return '-1';function val(r,k){var v=r==null?null:r.getProperty(k);return v==null?'':String(v);}";
    code = code + "function norm(t){t=String(t||'');if(t=='analysis_area'||t=='mask')return 'analysis_mask';if(t=='surface')return 'surface_reference';return t;}function typ(r){var a=norm(val(r,'Type')),b=norm(val(r,'Object_type'));if(a!=''&&b!=''&&a!=b)return 'TYPE_CONFLICT';return a!=''?a:b;}";
    code = code + "function oid(r,t){var id='',primary='',alias='';if(t=='cavity'){primary=val(r,'Cavity_id');alias=val(r,'cavity_id');if(primary!=''&&alias!=''&&primary!=alias)return 'ID_CONFLICT';id=primary!=''?primary:alias;}else if(t=='panel'){id=val(r,'Panel_id');if(id=='')id=val(r,'Object_id');}else if(t=='analysis_mask'){id=val(r,'Mask_id');if(id=='')id=val(r,'Object_id');}else if(t=='exclusion'){id=val(r,'Exclusion_id');if(id=='')id=val(r,'Object_id');}else if(t=='dislocation_loop'){id=val(r,'Object_id');if(id=='')id=val(r,'Feature_id');}else{id=val(r,'Feature_id');if(id=='')id=val(r,'Object_id');}if(id=='')id=String(r.getName()||'');return id;}";
    code = code + "function sha(r){try{var b=RE.saveAsByteArray(r),d=MD.getInstance('SHA-256').digest(b),s='';for(var i=0;i<d.length;i++){var v=Number(d[i])&255;s+=(v<16?'0':'')+v.toString(16);}return s;}catch(ex){return '';}}";
    code = code + "for(var i=0;i<rm.getCount();i++){var r=rm.getRoi(i),t=typ(r),up=val(r,'Object_uuid'),ua=val(r,'object_uuid');if(up!=''&&ua!=''&&up!=ua)return '-4';var u=up!=''?up:ua,id=oid(r,t);if(id=='ID_CONFLICT')return '-5';if(t==wantedType&&u==wantedUuid&&id==wantedId){if(found>=0)return '-2';if(sha(r)!=wantedSha)return '-3';found=i;}}return String(found);})()";
    result = "" + eval("js", code);
    idx = parseFloat(result);
    if (isNaN(idx)) return -1;
    return round(idx);
}


function p1RestoreScientificSelectionToken(selectionToken) {
    if (selectionToken == "NEUTRAL") {
        roiManager("deselect");
        Roi.selectNone;
        return 1;
    }
    if (startsWith(selectionToken, "CONFLICT")) return 0;
    parts = split(selectionToken, "|");
    if (parts.length != 5 || parts[0] != "ROI") return 0;
    idx = p1FindScientificSelectionIndex(parts[1], parts[2], parts[3], parts[4]);
    if (idx < 0) return 0;
    if (!safeRoiSelect(idx)) return 0;
    restoredType = currentRoiType();
    if (restoredType != parts[1]) return 0;
    restoredToken = p1CaptureScientificSelectionToken();
    if (restoredToken != selectionToken) return 0;
    return 1;
}


function p1SelectMetadataIndexExact(idx) {
    if (idx < 0 || !safeRoiSelect(idx)) return 0;
    code = "(function(){var RM=Packages.ij.plugin.frame.RoiManager,WM=Packages.ij.WindowManager,RE=Packages.ij.io.RoiEncoder,MD=Packages.java.security.MessageDigest,rm=RM.getInstance2(),imp=WM.getCurrentImage(),idx=" + idx + ",sessionName='" + jsEscape(sessionMetadataName) + "',legacyName='" + jsEscape(legacyMetadataName) + "';";
    code = code + "if(rm==null||imp==null||idx<0||idx>=rm.getCount()||rm.getSelectedIndex()!=idx)return '0';function val(r,k){var v=r==null?null:r.getProperty(k);return v==null?'':String(v);}function sha(r){try{var b=RE.saveAsByteArray(r),d=MD.getInstance('SHA-256').digest(b),s='';for(var i=0;i<d.length;i++){var v=Number(d[i])&255;s+=(v<16?'0':'')+v.toString(16);}return s;}catch(ex){return '';}}";
    code = code + "var mr=rm.getRoi(idx),ir=imp.getRoi(),a=val(mr,'Type'),b=val(mr,'Object_type'),n=mr==null?'':String(mr.getName()||''),nameOK=n==sessionName||n==legacyName;if(mr==null||ir==null||(a!=''&&b!=''&&a!=b))return '0';var t=a!=''?a:b;if(!(t=='session_metadata'||(t==''&&nameOK)))return '0';var mh=sha(mr),ih=sha(ir);return mh!=''&&mh==ih?'1':'0';})()";
    bindingResult = "" + eval("js", code);
    if (bindingResult == "1") return 1;
    return 0;
}


function updateSessionMetadataRoi() {
    if (nImages() <= 0) return 0;
    run("ROI Manager...");
    selectionToken = p1CaptureScientificSelectionToken();
    if (startsWith(selectionToken, "CONFLICT")) {
        showStatus("CTL P1: seleccion cientifica divergente; session_metadata no se actualizo.");
        return 0;
    }
    refreshImageIdentityIfMissing();
    updateScaleMaybe();

    idx = findMetadataIndex();
    if (idx < -1) {
        if (!p1RestoreScientificSelectionToken(selectionToken)) {
            roiManager("deselect");
            Roi.selectNone;
        }
        showStatus("CTL P1 METADATA_INVENTORY_AMBIGUOUS: session_metadata no se actualizo.");
        return 0;
    }
    if (idx >= 0) {
        if (!p1SelectMetadataIndexExact(idx)) {
            if (!p1RestoreScientificSelectionToken(selectionToken)) {
                roiManager("deselect");
                Roi.selectNone;
            }
            showStatus("CTL P1 METADATA_SELECTION_FAILED: session_metadata no se modifico.");
            return 0;
        }
        Roi.setName(sessionMetadataName);
        Roi.setGroup(0);
        Roi.setFillColor("#00000000");
        Roi.setStrokeColor("#00000000");
        writeMetadataProperties();
        roiManager("update");
    } else {
        makeRectangle(0, 0, 1, 1);
        Roi.setName(sessionMetadataName);
        Roi.setGroup(0);
        Roi.setFillColor("#00000000");
        Roi.setStrokeColor("#00000000");
        writeMetadataProperties();
        roiManager("add");
    }
    if (!p1RestoreScientificSelectionToken(selectionToken)) {
        roiManager("deselect");
        Roi.selectNone;
        showStatus("CTL P1 METADATA_SELECTION_RESTORE_FAILED: seleccion neutral aplicada.");
        return 0;
    }
    return 1;
}

