function p1RunValidate() {
    contextJson = p1CaptureOperationContext("validate");
    if (contextJson == "") return;
    result = p1BridgeCall("validate","EXECUTE",contextJson,"");
    showStatus("CTL P1 validate: " + result);
}


function p1RunTransactionalOperation(operation) {
    if (!p1RequireScientificWrite(operation)) return;
    contextJson = p1CaptureOperationContext(operation);
    if (contextJson == "") return;
    prepared = p1BridgeCall(operation,"PREPARE",contextJson,"");
    if (!startsWith(prepared,"PASS|")) { showStatus("CTL P1 " + operation + " bloqueado: " + prepared); return; }
    fields = split(prepared,"|");
    if (fields.length < 2 || fields[1] == "") { showStatus("CTL P1 prepare sin token"); return; }
    token = fields[1];
    evt006Barrier = p1AwaitEvt006PrepareSwitch(contextJson);
    if (evt006Barrier != "NOT_ACTIVE") {
        // A harness marker is one-shot and test-only.  Success proves that the
        // EDT really activated B; every failure is also terminal fail-closed.
        // In either case this prepared transaction can only be rolled back.
        aborted = p1BridgeCall(operation,"ABORT",contextJson,token);
        if (evt006Barrier == "SWITCH_VERIFIED") {
            p1AuditStale(contextJson,operation);
            showStatus("CTL P1 " + operation + ": EVT006_SWITCH_VERIFIED_ABORT|" + aborted);
        } else {
            showStatus("CTL P1 " + operation + ": EVT006_BARRIER_FAILED_ABORT|" + evt006Barrier + "|" + aborted);
        }
        return;
    }
    if (!p1ContextStillCurrent(contextJson)) {
        p1BridgeCall(operation,"ABORT",contextJson,token);
        p1AuditStale(contextJson,operation);
        showStatus("CTL P1 " + operation + ": STALE_CONTEXT_CANCELLED");
        return;
    }
    committed = p1BridgeCall(operation,"COMMIT",contextJson,token);
    showStatus("CTL P1 " + operation + ": " + committed);
}


function p1ChooseCombinedAndRun() {
    if (!p1RequireScientificWrite("combined_analysis")) return;
    ids = lightChooseRegistryImages(1);
    if (ids == "") { showStatus("CTL P1 combined_analysis cancelado sin mutaciones."); return; }
    code = "var imp=Packages.ij.WindowManager.getCurrentImage();if(imp!=null)imp.setProperty('CTL.P1.combined_selected_image_ids','" + jsEscape(ids) + "');'OK';";
    eval("js",code);
    p1RunTransactionalOperation("combined_analysis");
}


function p1ChoosePrompt1RevisionRelativePath() {
    if (lightProjectRoot == "" || lightImageId == "") return "ERROR|PROJECT_IMAGE_CONTEXT_MISSING";
    code = "(function(){var F=Packages.java.io.File,Files=Packages.java.nio.file.Files,JOption=Packages.javax.swing.JOptionPane;";
    code = code + "function clean(v){return String(v).replace(/[\\r\\n|]/g,' ');}function same(a,b){return String(a.getCanonicalPath())==String(b.getCanonicalPath());}function plainFile(parent,name){var f=new F(parent,name);return f.isFile()&&!Files.isSymbolicLink(f.toPath())&&same(f.getCanonicalFile().getParentFile(),parent);}";
    code = code + "try{var root=new F('" + jsEscape(lightProjectRoot) + "').getCanonicalFile(),imageDir=new F(new F(root,'images'),'" + jsEscape(lightImageId) + "').getCanonicalFile(),sessions=new F(imageDir,'roi_sessions').getCanonicalFile();if(!root.isDirectory()||!imageDir.isDirectory()||!sessions.isDirectory()||Files.isSymbolicLink(root.toPath())||Files.isSymbolicLink(imageDir.toPath())||Files.isSymbolicLink(sessions.toPath())||!same(imageDir.getParentFile(),new F(root,'images').getCanonicalFile())||!same(sessions.getParentFile(),imageDir))throw new Error('canonical_revision_root_invalid');";
    code = code + "var entries=sessions.listFiles(),names=[],i,e,c,n;if(entries!=null)for(i=0;i<entries.length;i++){e=entries[i];if(!e.isDirectory()||Files.isSymbolicLink(e.toPath()))continue;c=e.getCanonicalFile();n=String(e.getName());if(!same(c.getParentFile(),sessions)||n.indexOf('REV_')!=0||String(c.getName())!=n)continue;if(!plainFile(c,'COMPLETE')||!plainFile(c,'REVISION_SHA256.txt')||!plainFile(c,'revision_manifest.json')||!plainFile(c,'revision_metadata.json')||!plainFile(c,'cavity_rois.zip'))continue;names.push(n);}names.sort().reverse();if(names.length==0)return 'ERROR|NO_VERIFIED_P1_REVISION_CANDIDATES';var selected=JOption.showInputDialog(Packages.ij.IJ.getInstance(),'Selecciona una revision P1 verificada','Cargar revision P1',JOption.PLAIN_MESSAGE,null,names,names[0]);if(selected==null)return '';selected=String(selected);if(names.indexOf(selected)<0)throw new Error('revision_selection_not_listed');return 'images/" + jsEscape(lightImageId) + "/roi_sessions/'+selected;}catch(ex){return 'ERROR|'+clean(ex);}})();";
    return "" + eval("js",code);
}


function p1RunLoadRevision() {
    if (!p1RequireScientificWrite("cargar revision verificada")) return;
    selectedRelative = p1ChoosePrompt1RevisionRelativePath();
    if (selectedRelative == "") {
        showStatus("CTL P1 load_revision cancelado sin mutaciones.");
        return;
    }
    if (startsWith(selectedRelative,"ERROR|")) {
        showStatus("CTL P1 load_revision bloqueado: " + selectedRelative);
        return;
    }
    p1LoadRevisionRelativePath = selectedRelative;
    p1LoadWorkingStateId = "WORKING_" + substring(replace(lightUuid(),"-",""),0,16);
    contextJson = p1CaptureOperationContext("load_revision");
    if (contextJson == "") {
        p1LoadRevisionRelativePath = "";
        p1LoadWorkingStateId = "";
        return;
    }
    bridgeResult = p1BridgeCall("load_revision","EXECUTE",contextJson,"");
    if (!startsWith(bridgeResult,"PASS|")) {
        p1LoadRevisionRelativePath = "";
        p1LoadWorkingStateId = "";
        showStatus("CTL P1 load_revision bloqueado: " + bridgeResult);
        return;
    }
    code = "(function(){try{var IJ=Packages.ij.IJ,rt=IJ.getProperty('CTL.P1.Runtime'),imp=Packages.ij.WindowManager.getCurrentImage();if(rt==null||imp==null)throw new Error('runtime_or_image_missing');var raw=imp.getProperty('CTL.P1.last_bridge_response');if(raw==null||String(raw)=='')throw new Error('verified_bridge_response_missing');var loaded=rt.applyVerifiedRevisionLoad(imp,String(raw));return 'PASS\\t'+String(loaded.working_state_id)+'\\t'+String(loaded.revision_id)+'\\t'+String(loaded.revision_uid)+'\\t'+String(loaded.revision_manifest_sha256)+'\\t'+String(loaded.roi_count)+'\\t'+String(loaded.selected_is_current)+'\\t'+String(loaded.current_run_binding_status);}catch(ex){return 'ERROR|'+String(ex).replace(/[\\r\\n\\t|]/g,' ');}})();";
    applied = "" + eval("js",code);
    p1LoadRevisionRelativePath = "";
    p1LoadWorkingStateId = "";
    if (startsWith(applied,"ERROR|")) {
        showStatus("CTL P1 load_revision no aplicado: " + applied);
        return;
    }
    fields = split(applied,"\t");
    if (fields.length != 8 || fields[0] != "PASS" || fields[1] == "") {
        showStatus("CTL P1 load_revision respuesta aplicada invalida.");
        return;
    }
    p1WorkingStateId = fields[1];
    lightCurrentRevision = "";
    lightCurrentRunId = "";
    storedGeneration = parseFloat(p1ImageProperty("CTL.P1.generation_token"));
    if (!isNaN(storedGeneration) && storedGeneration >= 1) p1GenerationToken = floor(storedGeneration);
    storedSelection = parseFloat(p1ImageProperty("CTL.P1.selection_revision"));
    if (!isNaN(storedSelection) && storedSelection >= 0) p1SelectionRevision = floor(storedSelection);
    lightInvalidateAnalysisCache();
    p1StampImageContext();
    showAllRois();
    showStatus("CTL P1 revision " + fields[2] + " cargada en working state " + fields[1] + "; RUN desligado solo en memoria; escrituras de proyecto=0.");
}


function p1LegacyWriteBlocked(actionText) {
    showMessage("Escritura legacy bloqueada", "CTL P1 no ejecuta " + actionText + " sobre el descriptor/proyecto schema 1. No existe fallback de reparacion o migracion en Prompt 1.");
}


function p1AutoRun() {
    lightInvalidateAnalysisCache();usePanelsAsMask=0;v4ProjectLoaded=0;
    if(nImages()>0){updateScaleMaybe();run("ROI Manager...");p1StampImageContext();p1InstallInteractionListeners(0);lightInteractivePushState(lightInteractiveMode);}
    lightShowPanel();showStatus("Cavity TEM Light Prompt 1 activo; carga/reparacion/escritura legacy automatica=0.");
}


function p1ResolveSourcePathReadOnly() {
    if(lightProjectRoot==""||lightImageId==""||lightSourceSha256==""||lengthOf(lightSourceSha256)!=64){showMessage("Fuente no disponible","Falta el contexto cerrado project/image/source_sha256.");return "";}
    code="(function(){try{var F=Packages.java.io.File,Files=Packages.java.nio.file.Files,Link=Packages.java.nio.file.LinkOption,Sys=Packages.java.lang.System,isWindows=String(Sys.getProperty('os.name')).toLowerCase().indexOf('windows')>=0,K=null,WB=null,SI=null,DW=null;";
    code=code+"function same(a,b){return String(a.getCanonicalPath())==String(b.getCanonicalPath());}function req(c,m){if(!c)throw new Error(m);}function safeNode(f,leaf){var absolute=f.getAbsoluteFile(),canonical=f.getCanonicalFile(),current=absolute,attrs,handle=null,info;req(absolute.exists()&&String(absolute.getAbsolutePath())===String(canonical.getAbsolutePath()),'noncanonical_node');while(current!=null){req(!Files.isSymbolicLink(current.toPath()),'symbolic_link');if(isWindows){if(K==null){K=Packages.com.sun.jna.platform.win32.Kernel32.INSTANCE;WB=Packages.com.sun.jna.platform.win32.WinBase;SI=Packages.com.sun.jna.platform.win32['WinBase$FILE_STANDARD_INFO'];DW=Packages.com.sun.jna.platform.win32['WinDef$DWORD'];}attrs=Number(K.GetFileAttributes(String(current.getAbsolutePath())));req(attrs>=0&&(attrs&1024)==0,'reparse_point');}current=current.getParentFile();}if(leaf){req(absolute.isFile(),'source_not_regular');if(isWindows){handle=K.CreateFile(String(absolute.getAbsolutePath()),0,7,null,3,35651584,null);try{req(handle!=null&&!WB.INVALID_HANDLE_VALUE.equals(handle),'source_handle');info=new SI();req(K.GetFileInformationByHandleEx(handle,1,info.getPointer(),new DW(info.size())),'source_identity');info.read();req(Number(info.NumberOfLinks)===1,'source_hardlink');}finally{if(handle!=null&&!WB.INVALID_HANDLE_VALUE.equals(handle))K.CloseHandle(handle);}}else req(Number(Files.getAttribute(absolute.toPath(),'unix:nlink',Link.NOFOLLOW_LINKS))===1,'source_hardlink');}else req(absolute.isDirectory(),'directory_not_plain');return canonical;}";
    code=code+"var root=safeNode(new F('"+jsEscape(lightProjectRoot)+"'),false),images=safeNode(new F(root,'images'),false),image=safeNode(new F(images,'"+jsEscape(lightImageId)+"'),false),source=safeNode(new F(image,'source'),false);req(same(images.getParentFile(),root)&&same(image.getParentFile(),images)&&same(source.getParentFile(),image),'project_local_source_layout');var entries=source.listFiles(),candidate=null,count=0;req(entries!=null,'source_directory_unreadable');for(var i=0;i<entries.length;i++){var e=entries[i],name=String(e.getName()).toLowerCase();if(!/\\.(dm3|dm4)$/.test(name))continue;e=safeNode(e,true);req(same(e.getParentFile(),source),'source_parent');candidate=e;count++;}req(count===1,'source_candidate_count_'+count);return 'OK|'+String(candidate.getCanonicalPath());}catch(ex){return 'ERROR|'+String(ex).replace(/[\\r\\n|]/g,' ');}})();";
    resolved=""+eval("js",code);if(startsWith(resolved,"ERROR|")){showMessage("Fuente no disponible","La copia controlada images/<image_id>/source fue rechazada: "+resolved);return "";}
    fields=split(resolved,"|");if(fields.length!=2||fields[0]!="OK"){showMessage("Fuente no disponible","Respuesta invalida del resolvedor local cerrado.");return "";}
    candidate=normalizeStoredPath(fields[1]);actualSha=IJ.checksum("SHA-256 file",candidate);if(actualSha!=lightSourceSha256){showMessage("Integridad bloqueada","El unico DM3/DM4 de la copia controlada no coincide con source_sha256.");return "";}
    return candidate;
}


function p1OpenProjectReadOnly() {
    selectedPath=File.openDialog("Selecciona cavity_light_project.tsv (solo lectura P1)");
    if(selectedPath=="")return;
    selectedPath=normalizeStoredPath(selectedPath);
    if(File.getName(selectedPath)!=lightProjectFileName){showMessage("Archivo rechazado","Prompt 1 exige seleccionar exactamente "+lightProjectFileName+". No busca ni repara descriptores legacy.");return;}
    if(lightProjectDescriptorValid(selectedPath,"","")==0){showMessage("Proyecto invalido","El descriptor schema 1 no supera la validacion de lectura.");return;}
    if(!lightPrepareProjectSwitch())return;
    if(lightLoadProjectFile(selectedPath)==0)return;
    imagesPath=lightJoin(lightProjectRoot,"images");registryPath=lightJoin(lightProjectRoot,lightRegistryFileName);
    if(!File.exists(imagesPath)||!File.exists(registryPath)){failedRoot=lightProjectRoot;lightClearProjectState();showMessage("Proyecto incompleto","Prompt 1 no crea ni repara la estructura schema 1. Faltan images o images.tsv en:\n"+failedRoot);return;}
    showMessage("Proyecto abierto en solo lectura","Proyecto: "+lightProjectName+"\nMuestra: "+sampleName+"\nCondicion: "+experimentalCondition+"\nRaiz: "+lightProjectRoot+"\n\nNo se ha escrito descriptor, registro, log ni revision schema 1.");
    lightShowPanel();
}


function p1OpenRegisteredImageReadOnly(id,installListeners) {
    imagesRoot=lightJoin(lightProjectRoot,"images");canonicalImageDir=lightNormalizeDir(lightJoin(imagesRoot,id));meta=lightJoin(canonicalImageDir,lightImageMetadataFileName);
    if(!File.exists(meta)){showMessage("Registro incompleto","No existe: "+meta+"\nPrompt 1 no lo reconstruye.");return 0;}
    lightImageId=id;lightImageDir=canonicalImageDir;
    if(lightReadImageMetadata()==0)return 0;
    expectedProjectId=lightProjectId;expectedProjectUid=lightProjectUid;expectedImageId=lightImageId;expectedSha=lightSourceSha256;expectedRoot=lightProjectRoot;expectedImageDir=lightImageDir;
    resolvedPath=p1ResolveSourcePathReadOnly();if(resolvedPath=="")return 0;
    actualSha=IJ.checksum("SHA-256 file",resolvedPath);if(actualSha!=expectedSha){showMessage("Integridad bloqueada","La fuente local controlada no coincide con source_sha256.");return 0;}
    run("ROI Manager...");if(roiManager("count")>0){if(!getBoolean("Limpiar el ROI Manager antes de abrir la imagen?","Limpiar solo memoria","Cancelar"))return 0;roiManager("reset");}
    run("Bio-Formats Importer","open=["+lightEscapeRunPath(resolvedPath)+"] autoscale color_mode=Default view=Hyperstack stack_order=XYCZT");if(nImages()<=0)return 0;if(!lightValidateSingle2D())return 0;
    sx=lightKvNumber(meta,"active_scale_x_nm_px",lightOriginalScaleNmX);sy=lightKvNumber(meta,"active_scale_y_nm_px",lightOriginalScaleNmY);if(sx>0&&sy>0){setVoxelSize(sx,sy,1,"nm");updateScaleMaybe();}
    imageFileName=File.getName(resolvedPath);imageDirectory=normalizeStoredPath(File.getDirectory(resolvedPath));imageChecksum=expectedSha;montageId=expectedImageId;sourceFirst=imageFileName;sourceLast=imageFileName;sourceImageList=imageFileName;
    lightProjectId=expectedProjectId;lightProjectUid=expectedProjectUid;lightImageId=expectedImageId;lightSourceSha256=expectedSha;lightProjectRoot=expectedRoot;lightImageDir=expectedImageDir;lightSourcePath=resolvedPath;lightSourceStoredPath=resolvedPath;lightCopySource=0;lightCurrentRevision="";lightCurrentRunId="";projectConfigured=1;lightProjectLoaded=1;v4ProjectLoaded=0;
    p1ResetImageScopedRuntimeGlobals();setMetadataImageProperties();updateSessionMetadataRoi();
    if(!p1BindExpectedPixelFreezeReadOnly()){close();return 0;}
    stampOk=p1StampImageContext();verifyStatus="NOT_VERIFIED";if(stampOk)verifyStatus=p1VerifyMaster();
    if(!stampOk||verifyStatus!="VERIFIED"){showMessage("Master P1 no verificado","La imagen se cierra sin guardar porque source/master no superan la verificacion independiente.");close();return 0;}
    if(installListeners==1)p1InstallInteractionListeners(0);
    showStatus("Imagen abierta en memoria; escrituras/reparaciones/revision legacy=0.");lightShowPanel();return 1;
}


function p1SelectProjectImageReadOnly(installListeners) {
    if(lightProjectLoaded!=1){showMessage("Sin proyecto","Abra primero un descriptor schema 1 con la ruta de solo lectura Prompt 1.");return 0;}
    if(lightRegistryHasDataRows()==0){showMessage("Sin imagenes seleccionables","images.tsv no contiene filas utilizables. Prompt 1 no ejecuta reconstruccion automatica.");return 0;}
    id=lightChooseRegistryImages(0);if(id=="")return 0;
    return p1OpenRegisteredImageReadOnly(id,installListeners);
}


function p1SelectProjectImageTwoPhase() {
    if (!p1EnsureRuntime()) { showStatus("CTL P1 cambio bloqueado: runtime ausente."); return; }
    if (nImages() <= 0) { p1SelectProjectImageReadOnly(1); return; }
    p1StampImageContext();
    oldId = "" + eval("js","var imp=Packages.ij.WindowManager.getCurrentImage();imp==null?'':String(imp.getID());");
    code = "(function(){try{var rt=Packages.ij.IJ.getProperty('CTL.P1.Runtime');return String(rt.prepareImageSwitch(Packages.ij.WindowManager.getCurrentImage()));}catch(ex){return 'ERROR|'+String(ex).replace(/[\\r\\n|]/g,' ');}})();";
    token = "" + eval("js",code);
    if (startsWith(token,"ERROR|")) { showStatus("CTL P1 cambio bloqueado: " + token); return; }
    p1ResetExpectedPixelBindingGlobals();
    opened = p1SelectProjectImageReadOnly(0);
    newId = "" + eval("js","var imp=Packages.ij.WindowManager.getCurrentImage();imp==null?'':String(imp.getID());");
    if (opened != 1 || newId == oldId || newId == "") {
        code = "var rt=Packages.ij.IJ.getProperty('CTL.P1.Runtime');String(rt.cancelImageSwitch('" + jsEscape(token) + "'));";
        result = "" + eval("js",code);
        showStatus("CTL P1 cambio de imagen: " + result);
        return;
    }
    p1ImageUid="";p1AnalysisSessionId="";p1AnalysisSessionUid="";p1WorkingStateId="";p1GenerationToken=1;p1SelectionRevision=0;
    p1StampImageContext();
    code = "var rt=Packages.ij.IJ.getProperty('CTL.P1.Runtime');String(rt.commitImageSwitch('" + jsEscape(token) + "',Packages.ij.WindowManager.getCurrentImage()));";
    result = "" + eval("js",code);
    showStatus("CTL P1 cambio de imagen: " + result);
}


function p1ConfirmImageScaleInMemory() {
    if(!p1RequireScientificWrite("confirmar escala"))return;
    if(!updateScaleMaybe()){showMessage("Escala no valida","No existe calibracion fisica verificable.");return;}
    msg="Escala detectada: "+d2s(nmPerPixelX,12)+" x "+d2s(nmPerPixelY,12)+" nm/px\n\nConfirmar solo en el working state Prompt 1?";if(!getBoolean(msg,"Confirmar en memoria","Cancelar"))return;
    lightScaleConfirmed=1;if(lightScaleOrigin=="bioformats_metadata")lightScaleOrigin="bioformats_metadata_confirmed";scaleDefined=1;updateSessionMetadataRoi();
    code="var imp=Packages.ij.WindowManager.getCurrentImage();imp.setProperty('CTL.P1.scale_x_nm_px','"+d2s(nmPerPixelX,15)+"');imp.setProperty('CTL.P1.scale_y_nm_px','"+d2s(nmPerPixelY,15)+"');imp.setProperty('CTL.P1.scale_method','BIOFORMATS_CONFIRMED_V1');'OK';";eval("js",code);p1StampImageContext();showStatus("Escala confirmada en memoria; schema 1 sin cambios.");
}


function p1UseWholeImageInMemory() {
    if(!p1RequireScientificWrite("definir area"))return;
    if(!getBoolean("Confirmar toda la imagen como material observable valido en el working state?","Confirmar en memoria","Cancelar"))return;
    lightUseWholeImage=1;syncAllObjects(0);updateSessionMetadataRoi();p1StampImageContext();showStatus("Area completa aplicada en memoria; schema 1 sin cambios.");
}


function p1DefineSurfaceInMemory() {
    if(!p1RequireScientificWrite("definir superficie"))return;
    if(lightImageMode!="with_surface"){if(!getBoolean("Cambiar a modo con superficie solo en el working state?","Cambiar en memoria","Cancelar"))return;lightImageMode="with_surface";excludeNegativeDepth=1;}
    defineSurfaceReference();updateSessionMetadataRoi();p1StampImageContext();showStatus("Superficie aplicada en memoria; schema 1 sin cambios.");
}


function p1ToggleLabelsInMemory() {
    showRoiLabels=1-showRoiLabels;lightInteractivePushState(lightInteractiveMode);showAllRois();updateSessionMetadataRoi();p1StampImageContext();lightRefreshPanel();
}


function p1FinalizeInteractiveActiveDiameterInMemory() {
    if(!p1RequireScientificWrite("confirmar diametro activo"))return;
    previousMode=lightInteractiveMode;if(lightInteractivePullActiveDiameter()==0)return;updateSessionMetadataRoi();lightInteractivePushState(previousMode);p1StampImageContext();lightRefreshPanel();showStatus("Diametro activo confirmado en memoria; schema 1 sin cambios.");
}


function p1UpdateResizeStepInMemory() {
    allowed=p1RequireScientificWrite("actualizar sensibilidad");
    code="(function(){var IJ=Packages.ij.IJ,v=IJ.getProperty('CTL.P1.pending_resize_step_nm');IJ.setProperty('CTL.P1.pending_resize_step_nm',null);return v==null?'':String(v);})();";
    raw=""+eval("js",code);
    if(!allowed)return;
    value=parseFloat(raw);
    if(isNaN(value)||value<lightInteractiveResizeMinNm||value>lightInteractiveResizeMaxNm){showMessage("Sensibilidad rechazada","El valor pendiente no pertenece al rango cerrado permitido.");return;}
    lightInteractiveResizeStepNm=value;lightInteractiveSaveResizePreference();lightInteractivePushState(lightInteractiveMode);updateSessionMetadataRoi();p1StampImageContext();lightRefreshPanel();showStatus("Sensibilidad aplicada en memoria; preferencia y schema 1 sin cambios.");
}


function p1SetScaleNumerically() {
    if (!p1RequireScientificWrite("cambiar escala X/Y")) return;
    updateScaleMaybe();
    Dialog.create("Escala X/Y Prompt 1");
    Dialog.addNumber("scale_x_nm_px:",nmPerPixelX,12,"nm/px");
    Dialog.addNumber("scale_y_nm_px:",nmPerPixelY,12,"nm/px");
    Dialog.addString("Evidencia/origen:","manual_xy_independent",40);
    Dialog.show();
    sx=Dialog.getNumber();sy=Dialog.getNumber();evidence=Dialog.getString();
    if (!(sx>0) || !(sy>0) || evidence=="") { showMessage("Escala bloqueada","X e Y positivas y evidencia no vacia son obligatorias. No se fuerza isotropia."); return; }
    setVoxelSize(sx,sy,1,"nm");updateScaleMaybe();lightScaleConfirmed=1;lightScaleOrigin=evidence;scaleDefined=1;
    code="var imp=Packages.ij.WindowManager.getCurrentImage();imp.setProperty('CTL.P1.scale_x_nm_px','"+d2s(sx,15)+"');imp.setProperty('CTL.P1.scale_y_nm_px','"+d2s(sy,15)+"');imp.setProperty('CTL.P1.scale_method','MANUAL_XY_INDEPENDENT_V1');imp.setProperty('CTL.P1.scale_evidence','"+jsEscape(evidence)+"');'OK';";eval("js",code);
    syncAllObjects(0);updateSessionMetadataRoi();p1StampImageContext();showStatus("Escala X/Y independiente aplicada; working state queda DIRTY_UNREVIEWED.");
}


function p1CalibrateScaleFromLine() {
    if (!p1RequireScientificWrite("calibrar escala por linea")) return;
    updateScaleMaybe();oldX=nmPerPixelX;oldY=nmPerPixelY;
    setTool("line");
    if (!waitForUserSafe("Calibrar eje","Dibuja una referencia horizontal o vertical. Una linea oblicua no resuelve X/Y y se rechazara.")) return;
    getLine(x1,y1,x2,y2,lw);if(x1==-1)return;
    dx=abs(x2-x1);dy=abs(y2-y1);epsilon=1e-6;
    if (dx>epsilon && dy>epsilon) { showMessage("Evidencia anisotropa insuficiente","Una referencia oblicua aporta una ecuacion para dos escalas. CTL P1 no inventa X/Y ni fuerza isotropia."); return; }
    pixels=max2(dx,dy);if(!(pixels>0))return;
    known=getNumber("Longitud real del eje (nm):",50);if(!(known>0))return;
    axisEvidence=getString("Evidencia independiente del eje conservado:","metadata_Bio-Formats_verificada");if(axisEvidence=="")return;
    sx=oldX;sy=oldY;orientation=0;
    if(dx>epsilon){sx=known/dx;orientation=0;}else{sy=known/dy;orientation=90;}
    if(!(sx>0)&&!(sy>0)){showMessage("Escala bloqueada","El eje no medido carece de evidencia valida.");return;}
    setVoxelSize(sx,sy,1,"nm");updateScaleMaybe();scaleDefined=1;lightScaleConfirmed=1;lightScaleOrigin="ANISOTROPIC_AXIS_V1";
    code="var imp=Packages.ij.WindowManager.getCurrentImage();imp.setProperty('CTL.P1.scale_x_nm_px','"+d2s(sx,15)+"');imp.setProperty('CTL.P1.scale_y_nm_px','"+d2s(sy,15)+"');imp.setProperty('CTL.P1.scale_method','ANISOTROPIC_AXIS_V1');imp.setProperty('CTL.P1.scale_axis_orientation_deg','"+orientation+"');imp.setProperty('CTL.P1.scale_axis_evidence','"+jsEscape(axisEvidence)+"');'OK';";eval("js",code);
    syncAllObjects(0);updateSessionMetadataRoi();p1StampImageContext();showStatus("Calibracion ANISOTROPIC_AXIS_V1 aplicada sin forzar isotropia.");
}


function p1FinalizeInteractiveEdit() {
    if (!p1RequireScientificWrite("confirmar edicion interactiva")) return;
    lightFinalizeInteractiveEdit();
    p1SelectionRevision++;
    p1StampImageContext();
}


function p1OpenDmAndRegister() { p1LegacyWriteBlocked("registro/importacion de DM3/DM4 legacy"); }
function p1RegisterActiveImage() { p1LegacyWriteBlocked("registro de imagen activa legacy"); }
function p1GuardedAddCavityAtCursor() { if (p1RequireScientificWrite("anadir cavidad")) addCavityAtCursor(); }
function p1GuardedMeasureCavityByDrag() { if (p1RequireScientificWrite("medir cavidad")) measureCavityByDrag(); }
function p1GuardedDeleteSelected() { if (p1RequireScientificWrite("borrar seleccion")) deleteSelectedManagedRoi(); }
function p1GuardedUndo() { if (p1RequireScientificWrite("deshacer")) undoLastAddOrDelete(); }
function p1SetActiveDiameterInMemory() {
    if (p1RequireScientificWrite("fijar diametro activo")) lightSetActiveDiameter();
}
function p1TakeDiameterFromSelectedInMemory() {
    if (p1RequireScientificWrite("tomar diametro de seleccion")) takeDiameterFromSelected();
}
function p1GuardedSelectOrForceAddAtCursor() {
    getCursorLoc(p1SelectX, p1SelectY, p1SelectZ, p1SelectFlags);
    if ((p1SelectFlags & 1) != 0 &&
        !p1RequireScientificWrite("anadir cavidad con Shift+clic")) return;
    selectOrForceAddAtCursor();
}


// =============================================================================
// CAVITY TEM LIGHT 1.1.1 R9 - FOCUSED WORKFLOW
// Compatible con proyectos schema 1 y revisiones ROI guardadas por R5.
// =============================================================================
// R6: numeric predicates return explicit 0/1 values. File.* and eval(...)
// are never returned directly from a user-defined function. The create-project
// flow can safely complete the empty partial skeleton left by the R2 interruption.

macro "AutoRun" { p1AutoRun(); }
